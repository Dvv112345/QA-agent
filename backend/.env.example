# Environment variables for the QA Agent backend
#
# Copy this file to .env and adjust values for your environment.

# ── Version ──────────────────────────────────────────────────────────
# Set to the current version number
VERSION=1.0.0

# ── Storage ──────────────────────────────────────────────────────────
# Set to "true" to persist uploaded files to STORAGE_LOCATION.
# Any other value (or unset) keeps files in memory only.
STORE_OFFLINE=false

# Directory where uploaded files are stored when STORE_OFFLINE=true.
# Created automatically if it doesn't exist.
STORAGE_LOCATION=./uploads

# ── Security limits ──────────────────────────────────────────────────
# Maximum upload size in megabytes (applies to both zip and markdown files).
MAX_UPLOAD_SIZE_MB=100

# Maximum number of entries (files + directories) allowed inside a zip archive.
MAX_ZIP_FILES=10000

# Maximum directory nesting depth for building the tree view.
MAX_TREE_DEPTH=100

# File streaming chunk size in bytes
CHUNK_SIZE=8192

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to access the API.
CORS_ORIGINS=http://localhost:5173
