# Environment variables for the QA Agent backend
#
# Copy this file to .env and adjust values for your environment.

# Set to "true" to persist uploaded files to STORAGE_LOCATION.
# Any other value (or unset) keeps files in memory only.
STORE_OFFLINE=false

# Directory where uploaded files are stored when STORE_OFFLINE=true.
# Created automatically if it doesn't exist.
STORAGE_LOCATION=./uploads
