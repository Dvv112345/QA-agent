# Environment variables for the QA Agent backend
#
# Copy this file to .env and adjust values for your environment.

# ── Version ──────────────────────────────────────────────────────────
# Set to the current version number
VERSION=1.0.0

# ── Storage ──────────────────────────────────────────────────────────
# Set to "true" to persist sprint README files to STORAGE_LOCATION.
# Any other value (or unset) keeps files in memory only.
STORE_OFFLINE=false

# Directory where sprint README files are stored when STORE_OFFLINE=true.
# Created automatically if it doesn't exist.
STORAGE_LOCATION=./uploads

# ── Security limits ──────────────────────────────────────────────────
# Maximum upload size in megabytes (applies to README and PRD file uploads).
MAX_UPLOAD_SIZE_MB=100

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to access the API.
CORS_ORIGINS=http://localhost:5173

# ── Authentication ──────────────────────────────────────────────────
# Shared password for accessing the QA Agent UI.
# Leave empty to disable authentication entirely.
APP_PASSWORD=

# ── PostgreSQL ───────────────────────────────────────────────────────
# PostgreSQL connection string for the qa_agent database.
# Create the database first: createdb qa_agent
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qa_agent

# ── Encryption ───────────────────────────────────────────────────────
# Fernet key for encrypting GitHub tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── GitHub API ───────────────────────────────────────────────────────
# Timeout in seconds for GitHub API requests.
GITHUB_API_TIMEOUT=15

# Character cap for the repo file-tree listing captured at sprint creation
# (LLM prompt context; longer listings are truncated).
FILE_TREE_MAX_CHARS=20000

# ── Redis / RQ ───────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=QaPassword
REDIS_DB=0
JOB_TIMEOUT=300
JOB_RESULT_TTL=3600

# RQ's idle poll wait is roughly (WORKER_TTL - 15) seconds; a blocking Redis
# call can't be interrupted by Ctrl+C on Windows, so this bounds worst-case
# worker shutdown latency (default RQ value is 420, i.e. ~7 minutes).
WORKER_TTL=30

# ── LLM (OpenAI-compatible API) ──────────────────────────────────────
# API key for the LLM provider. Required for requirement clarity analysis;
# without it, analysis jobs fail (requirements show a failed card).
OPENAI_API_KEY=

# Base URL of any OpenAI-compatible provider (default provider: DeepSeek).
# Leave empty to use api.openai.com.
OPENAI_BASE_URL=https://api.deepseek.com

# Model used for requirement clarity analysis.
OPENAI_MODEL=deepseek-v4-flash

# Timeout in seconds for LLM requests.
OPENAI_TIMEOUT=60

# Character cap on the README text included in LLM prompts
# (READMEs can be arbitrarily long; longer ones are truncated).
README_MAX_CHARS=8000

# ── Requirement analysis ─────────────────────────────────────────────
# Maximum clarification question/answer rounds per requirement; past the
# cap the UI only offers confirm-as-is or manual edit.
MAX_CLARIFICATION_ROUNDS=3

# Automatic retries (task errors, crashed workers) before a requirement
# is marked failed. Manual Restart is always available and uncapped.
MAX_AUTO_RETRIES=3

# ── PRD upload ───────────────────────────────────────────────────────
# Character cap on the text extracted from an uploaded PRD document;
# uploads over the cap are rejected (422), never truncated.
PRD_MAX_CHARS=50000

# Maximum number of requirements a single PRD split may produce; splits
# over the cap are rejected (422).
MAX_PRD_REQUIREMENTS=50

# ── Test environment analysis ────────────────────────────────────────
# Maximum answer/revise rounds for the test environment access text; past
# the cap the UI only offers direct edit (which resets nothing but is
# uncapped and always available).
MAX_TEST_ENV_REVISION_ROUNDS=3

# ── Test planning ────────────────────────────────────────────────────
# Maximum feedback/revise rounds per test plan; past the cap the UI only
# offers direct edit (uncapped, no LLM involved).
MAX_TEST_PLAN_FEEDBACK_ROUNDS=3

# Maximum read_file tool rounds the LLM may use while generating one test
# plan before it is forced to produce the final answer.
TEST_PLAN_TOOL_ROUNDS=8

# Per-file character cap for repo files fetched by the read_file tool
# (longer files are truncated with a marker).
TEST_PLAN_FILE_MAX_CHARS=20000

# RQ job timeout for test-plan generation jobs. Must cover a worst-case
# tool loop — up to (TEST_PLAN_TOOL_ROUNDS + 1) LLM calls × OPENAI_TIMEOUT
# plus GitHub fetches — so it is deliberately larger than JOB_TIMEOUT,
# which is sized for single-call requirement-analysis jobs.
TEST_PLAN_JOB_TIMEOUT=900

# Seconds between reconciler ticks (re-enqueues lost/backlogged jobs).
RECONCILER_INTERVAL=30

# Age in seconds after which an in-progress analysis heartbeat counts as
# a crashed worker. Must exceed OPENAI_TIMEOUT.
HEARTBEAT_STALE_SECONDS=180

# Age in seconds after which a pending row's "started" RQ job counts as a
# crashed worker (died before flipping the row to analyzing). Much shorter
# than HEARTBEAT_STALE_SECONDS since that flip is a single fast commit.
PENDING_JOB_STALE_SECONDS=30

# ── Test execution ───────────────────────────────────────────────────
# Requires `playwright install chromium` on the worker host (one-time,
# not run in CI — task tests mock the execution layer entirely).

# Additional LLM-authored fix attempts per test case before a stubborn
# script-bug verdict is given up on (case ends "error", not "failed").
MAX_SCRIPT_FIX_ROUNDS=3

# Maximum read_file tool rounds per test-script generation/diagnosis call
# before the LLM is forced to produce a final answer.
TEST_EXECUTION_TOOL_ROUNDS=5

# Wall-clock timeout in seconds for a single test-script subprocess run.
SCRIPT_EXECUTION_TIMEOUT=60

# RQ job timeout for test-execution jobs (one job per requirement). Must
# cover every case in the requirement's plan, each with up to
# (1 + MAX_SCRIPT_FIX_ROUNDS) generate/execute/diagnose cycles — a much
# larger worst case than TEST_PLAN_JOB_TIMEOUT.
TEST_EXECUTION_JOB_TIMEOUT=3600

# ── Exploratory testing ──────────────────────────────────────────────
# LLM-driven browser sessions (SBTM charters + SFDIPOT). Shares the
# `playwright install chromium` prerequisite with test execution above.

# The SBTM time box, in LLM tool rounds per session. This is the main lever
# on a run's duration: charters run serially, so a run takes the sum of its
# sessions. 4 charters x 25 actions is roughly 13 minutes.
EXPLORATORY_MAX_ACTIONS=25

# Cap on charters per run (also enforced on user-edited charter lists).
EXPLORATORY_MAX_CHARTERS=6

# Per-snapshot character cap — an ARIA snapshot of a large SPA is unbounded.
EXPLORATORY_SNAPSHOT_MAX_CHARS=20000

# How many recent snapshots stay verbatim in the LLM conversation. Older
# ones are replaced with a one-line placeholder, which is what keeps the
# session inside the context window without lossy summarization.
EXPLORATORY_SNAPSHOT_WINDOW=3

# Wall-clock timeout in seconds for a single Playwright action. Well below
# Playwright's 30s default — an exploratory action that takes 30s is usually
# itself the finding, and a stale element reference burns this whole budget.
EXPLORATORY_ACTION_TIMEOUT=10

# Display only: feeds the estimated duration shown before starting a run.
# Bounds nothing at runtime. Correct it once you have real timings.
EXPLORATORY_SECONDS_PER_ACTION=8

# Max findings a single session may record (runaway-model guard).
EXPLORATORY_MAX_FINDINGS=20

# RQ job timeout for exploratory runs (one job per run). Must cover every
# charter serially: MAX_CHARTERS x MAX_ACTIONS x ACTION_TIMEOUT plus the
# summary call.
EXPLORATORY_JOB_TIMEOUT=7200

# Set to false to watch the agent drive a visible browser (local debugging).
EXPLORATORY_HEADLESS=true
